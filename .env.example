# Snowflake source database (source and warehouse share the same Snowflake account)
SOURCE_SNOWFLAKE_DATABASE=RETAIL_SOURCE
SOURCE_SNOWFLAKE_SCHEMA=RETAIL

# AWS S3 writer credentials: prefer IAM roles / workload identity in deployed environments.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=replace-with-your-bucket
S3_PREFIX=retail-incremental-warehouse
S3_SSE=AES256

# Snowflake source + target account credentials
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=RETAIL_DW
SNOWFLAKE_SCHEMA=CONTROL
SNOWFLAKE_STORAGE_INTEGRATION=RETAIL_S3_INT
SNOWFLAKE_STAGE=RETAIL_S3_STAGE

# Pipeline controls
EXTRACT_CHUNK_SIZE=50000
HWM_LOOKBACK_MINUTES=5
PARQUET_COMPRESSION=snappy
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
